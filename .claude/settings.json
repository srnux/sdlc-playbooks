{
  "$comment": "Shared, committed harness wiring. Machine-specific things (absolute paths, personal hooks, tokens) belong in settings.local.json, which is gitignored.",

  "permissions": {
    "allow": [
      "Bash(node .claude/tools/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npx --yes serve:*)"
    ],
    "deny": []
  },

  "$hooks_comment": "The gate layer runs at command entry (tools/gate.mjs). These two hooks are the edit-time layer: they are the only thing that can stop a write that never went through a command.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-plan.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-hardcoded-colors.sh" }
        ]
      }
    ]
  }
}
